# Configuración de Telegram Bot
# Crea un bot con @BotFather en Telegram para obtener el Token
TELEGRAM_BOT_TOKEN=tu_token_aqui_ejemplo_123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# Consigue tu Chat ID enviando un mensaje a @userinfobot en Telegram
TELEGRAM_CHAT_ID=tu_chat_id_aqui_ejemplo_12345678

# Filtros de Vivienda (Modificable según presupuesto)
MAX_PRICE_EUR=300000

# Intervalo de comprobación en modo bucle (en segundos, ej: 14400 = 4 horas)
CHECK_INTERVAL_SECONDS=14400
